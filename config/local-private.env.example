# Local Private Edition: copy values into your shell or a non-versioned .env.
LLM_PROVIDER=ollama
# Leave blank so direct Python uses the Ollama localhost default while the
# Docker override selects host.docker.internal. Set an explicit private IP only
# when the model server is on another controlled host.
LLM_BASE_URL=
# Ollama never receives credentials. Only authenticated private vLLM may use
# this dedicated variable; generic/cloud LLM_API_KEY is intentionally ignored.
LLM_LOCAL_API_KEY=
LLM_PRIVACY_MODE=local_only
LLM_LOCAL_ENDPOINT_ALLOWLIST=localhost,127.0.0.1,host.docker.internal,ollama,vllm

# Replace with a model already installed in Ollama. No model is downloaded by
# the application at generation time.
LLM_MODEL_DEFAULT=qwen2.5:7b
LLM_MODEL_INTENT=
LLM_MODEL_CHART=
LLM_MODEL_WRITER=
LLM_MODEL_WRITER_FALLBACK=
LLM_MODEL_REVIEWER=

# Conservative compatibility settings for local instruction models.
LLM_TOOL_MODE=json
LLM_JSON_MODE=prompt
LLM_SYSTEM_MODE=merge
LLM_MAX_PARALLEL=4
LLM_RPM_LIMIT=24
LLM_TIMEOUT_SECONDS=120
LLM_BACKOFF_BASE=1.0
